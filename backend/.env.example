# Host and Port settings
HOST=127.0.0.1
PORT=8000

# LLM Providers API Keys (Optional, recommended for premium results)
# Leave blank to fall back to local HuggingFace models or heuristic replacement rules
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Hugging Face Settings
# Set to 'false' if you want to skip HuggingFace model download entirely and use heuristics fallback
ENABLE_LOCAL_HF=true
HF_MODEL_NAME=google-t5/t5-small
